rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth & Role Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? getUserData().role 
        : 'GUEST';
    }
    
    function isOwner() {
      return isAuthenticated() && (
        getUserRole() == 'OWNER' || 
        getUserRole() == 'owner' || 
        getUserRole() == 'SYSTEM_ADMIN' ||
        request.auth.token.email.matches('(?i)owner@civicmind[.]gov[.]in') ||
        request.auth.token.email.matches('(?i)vu[.]241fa04491@gmail[.]com')
      );
    }
    
    function isGovAdmin() {
      return isOwner() || (
        isAuthenticated() && (
          getUserRole() == 'GOVERNMENT_ADMIN' || 
          getUserRole() == 'government_admin' ||
          request.auth.token.email.matches('(?i).*@municipal[.]gov[.]in') ||
          request.auth.token.email.matches('(?i).*@civicmind[.]gov[.]in')
        )
      );
    }
    
    function isOfficer() {
      return isGovAdmin() || (
        isAuthenticated() && (
          getUserRole() == 'DEPARTMENT_OFFICER' || 
          getUserRole() == 'officer'
        )
      );
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isGovAdmin() || isOwner();
      
      match /{document=**} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isGovAdmin() || isOwner();
    }

    // Departments Registry
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if isGovAdmin() || isOwner();
    }

    // Officers Registry
    match /officers/{officerId} {
      allow read: if true;
      allow write: if isGovAdmin() || isOwner();
    }

    // Officer Work Updates
    match /officer_work_updates/{updateId} {
      allow read: if true;
      allow write: if true;
    }

    // Assignment History
    match /assignment_history/{historyId} {
      allow read: if true;
      allow write: if true;
    }

    // Agent Activity Logs & Audit Trail
    match /agent_activity_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // AP Government Projects & Officers
    match /ap_government_projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    match /ap_government_officers/{officerId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

